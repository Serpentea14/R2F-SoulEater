local function getOrCreateVignette()
	local player = Players.LocalPlayer
	if not player then return end

	local playerGui = player:WaitForChild("PlayerGui")

	local vignette = playerGui:FindFirstChild("RampageVignette")
	if not vignette then
		vignette = Instance.new("ScreenGui")
		vignette.Name = "RampageVignette"
		vignette.IgnoreGuiInset = true
		vignette.DisplayOrder = 1000
		vignette.ResetOnSpawn = false
		vignette.Parent = playerGui

		local image = Instance.new("ImageLabel")
		image.Name = "Vignette"
		image.Size = UDim2.new(1, 0, 1, 0)
		image.Position = UDim2.new(0, 0, 0, 0)
		image.BackgroundTransparency = 1
		image.Image = "rbxassetid://18398876534" 
		image.ImageColor3 = Color3.fromRGB(0, 0, 0)
		image.ImageTransparency = 0
		image.Parent = vignette
	end

	return vignette:FindFirstChild("Vignette")
end

local function tweenRampageVisuals(active)
	local cc = getOrCreateEffects()
	local camera = workspace.CurrentCamera
	local vignette = getOrCreateVignette()

	local ccGoal = active and {
		Saturation = -0.2,
		TintColor = Color3.fromRGB(240, 60, 60),
		Contrast = 0.08
	} or {
		Saturation = 0,
		TintColor = Color3.new(1, 1, 1),
		Contrast = 0
	}

	local fovGoal = active and { FieldOfView = RAMPAGE_FOV } or { FieldOfView = DEFAULT_FOV }

	TweenService:Create(cc, TweenInfo.new(1), ccGoal):Play()
	TweenService:Create(camera, TweenInfo.new(2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), fovGoal):Play()

	if vignette then
		local vignetteGoal = active and { ImageTransparency = 0 } or { ImageTransparency = 1 }
		TweenService:Create(vignette, TweenInfo.new(1.5), vignetteGoal):Play()
	end
end

local function addSuperArmorToFolder(folder)
	if not folder or not folder:IsA("Folder") or folder.Name == "SuperArmor" then return end
	if not movesFolder or not folder:IsDescendantOf(movesFolder) then return end

	if not folder:FindFirstChild("SuperArmor") then
		local superArmor = Instance.new("Folder")
		superArmor.Name = "SuperArmor"
		superArmor.Parent = folder
	end
end

local function addSuperArmorFolders()
	if not movesFolder then return end
	for _, obj in ipairs(movesFolder:GetDescendants()) do
		addSuperArmorToFolder(obj)
	end
end

local function removeAllSuperArmorFolders()
	if not movesFolder then return end
	for _, obj in ipairs(movesFolder:GetDescendants()) do
		if obj:IsA("Folder") and obj.Name == "SuperArmor" then
			obj:Destroy()
		end
	end
end

local function endRampage()
	infiniteRampage = false

	screenFlash(Color3.fromRGB(200, 200, 255), 0.5)

	if rampagePulseConnection then
		rampagePulseConnection:Disconnect()
		rampagePulseConnection = nil
	end

	if countdownConnection then
		countdownConnection:Disconnect()
		countdownConnection = nil
	end

	local localPlayer = Players.LocalPlayer
	if localPlayer then
		local playerGui = localPlayer:FindFirstChild("PlayerGui")
		if playerGui then
			local countdownGui = playerGui:FindFirstChild("RampageCountdown")
			if countdownGui then countdownGui:Destroy() end
		end
	end
	countdownBar = nil

	-- Clean up bloodlust color correction
	if bloodlustCC then
		TweenService:Create(bloodlustCC, TweenInfo.new(1), {
			Saturation = 0,
			TintColor = Color3.new(1, 1, 1),
			Contrast = 0
		}):Play()
		local ccRef = bloodlustCC
		bloodlustCC = nil
		task.delay(1, function()
			if ccRef then ccRef:Destroy() end
		end)
	end

	-- Clean up Bloodlust loop sound if still playing
	if bloodlustLoopSound then
		local oldSound = bloodlustLoopSound
		bloodlustLoopSound = nil
		TweenService:Create(oldSound, TweenInfo.new(2), { Volume = 0 }):Play()
		task.delay(2, function()
			if oldSound then oldSound:Destroy() end
		end)
	end

	if descendantConnection then
		descendantConnection:Disconnect()
		descendantConnection = nil
	end

	if rampageLoopSound then
		local oldSound = rampageLoopSound
		rampageLoopSound = nil

		TweenService:Create(oldSound, TweenInfo.new(2), { Volume = 0 }):Play()

		task.delay(2, function()
			if oldSound then
				oldSound:Destroy()
			end
		end)
	end

	getfenv().Activated = false
	removeAllSuperArmorFolders()
	tweenRampageVisuals(false)
	rampageActive = false

	for player, state in pairs(playerStates) do
		state.soulsCount = 0
		if state.killGoal then
			state.killGoal.Value = MAX_SOULS
		end
		updateSoulsUI(state)

		-- Reset combo on rampage end
		state.comboCount = 0
		state.totalDamage = 0
		state.comboDeadline = 0
		updateComboUI(state)

		local queued = state.pendingKills or 0
		state.pendingKills = 0

		if queued > 0 then
			task.spawn(function()
				for i = 1, queued do
					if rampageActive then return end

					task.wait(0.2)

					state.soulsCount += 1

					if state.soulsCount >= MAX_SOULS then
						startRampage(player)
						return
					end

					updateSoulsUI(state)
				end
			end)
		end
	end
end

local function startRampage(triggeringPlayer)
	if rampageActive then return end
	rampageActive = true

	local styles = ReplicatedStorage:FindFirstChild("Styles")
	if styles then
		local brawler = styles:FindFirstChild("Brawler")
		if brawler then
			local visualName = brawler:FindFirstChild("VisualName")
			if visualName then
				visualName.Value = "FISTICUFFS"
			end
		end
	end
	getfenv().Activated = true

	task.spawn(function()
		while getfenv().Activated do
			FillHeat()
			task.wait(0.1)
		end
	end)

	if triggeringPlayer and triggeringPlayer.Character then
		task.spawn(showTypewriterBillboard, triggeringPlayer.Character, "PROVE YOUR WORTH.", PROVE_WORTH_SOUND_ID)
		screenShake(2, 1)
	end

	showPopupToAll("RAMPAGE", RAMPAGE_POPUP_SOUND_ID)
	tweenRampageVisuals(true)
	screenFlash(Color3.new(1, 0, 0), 0.4)

	-- Pulsing vignette + FOV breathing during rampage
	if rampagePulseConnection then rampagePulseConnection:Disconnect() end
	local pulseVignette = getOrCreateVignette()
	local pulseStart = os.clock()
	rampagePulseConnection = RunService.RenderStepped:Connect(function()
		if not rampageActive then
			rampagePulseConnection:Disconnect()
			rampagePulseConnection = nil
			return
		end
		local t = os.clock() - pulseStart
		if pulseVignette then
			local pulse = 0.25 + 0.15 * math.sin(t * 3)
			pulseVignette.ImageTransparency = pulse
		end
		local pulseCamera = workspace.CurrentCamera
		if pulseCamera then
			pulseCamera.FieldOfView = RAMPAGE_FOV + 2 * math.sin(t * 1.5)
		end
	end)

	-- Handle sound transition: if Bloodlust loop is playing, fade it out and start Rampage loop at same timeposition
	if bloodlustLoopSound then
		local bloodTimePos = bloodlustLoopSound.TimePosition
		local oldBloodSound = bloodlustLoopSound
		bloodlustLoopSound = nil

		-- Fade out Bloodlust loop
		TweenService:Create(oldBloodSound, TweenInfo.new(2), { Volume = 0 }):Play()
		task.delay(2, function()
			if oldBloodSound then oldBloodSound:Destroy() end
		end)

		-- Start Rampage loop at 0 volume and fade in, matching Bloodlust's timeposition
		rampageLoopSound = playSound(SoundService, RAMPAGE_LOOP_SOUND_ID, true, 0)
		rampageLoopSound.TimePosition = bloodTimePos
		TweenService:Create(rampageLoopSound, TweenInfo.new(2), { Volume = 0.8 }):Play()
	else
		rampageLoopSound = playSound(SoundService, RAMPAGE_LOOP_SOUND_ID, true, 0.8)
	end
	addSuperArmorFolders()

	if movesFolder then
		descendantConnection = movesFolder.DescendantAdded:Connect(function(obj)
			if rampageActive and obj:IsA("Folder") then
				task.defer(addSuperArmorToFolder, obj)
			end
		end)
	end

	if not infiniteRampage then
		-- Countdown timer bar at top of screen
		local localPlayer = Players.LocalPlayer
		if localPlayer then
			local playerGui = localPlayer:FindFirstChild("PlayerGui")
			if playerGui then
				local existing = playerGui:FindFirstChild("RampageCountdown")
				if existing then existing:Destroy() end

				local countdownGui = Instance.new("ScreenGui")
				countdownGui.Name = "RampageCountdown"
				countdownGui.IgnoreGuiInset = true
				countdownGui.DisplayOrder = 998
				countdownGui.ResetOnSpawn = false
				countdownGui.Parent = playerGui

				local barBg = Instance.new("Frame")
				barBg.Size = UDim2.new(0.3, 0, 0, 6)
				barBg.Position = UDim2.new(0.5, 0, 0, 10)
				barBg.AnchorPoint = Vector2.new(0.5, 0)
				barBg.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
				barBg.BorderSizePixel = 0
				barBg.Parent = countdownGui

				countdownBar = Instance.new("Frame")
				countdownBar.Size = UDim2.new(1, 0, 1, 0)
				countdownBar.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
				countdownBar.BorderSizePixel = 0
				countdownBar.Parent = barBg

				local countdownGlow = Instance.new("UIStroke")
				countdownGlow.Name = "Glow"
				countdownGlow.Color = Color3.fromRGB(255, 50, 50)
				countdownGlow.Thickness = 2
				countdownGlow.Transparency = 0.7
				countdownGlow.Parent = countdownBar

				local rampStart = os.clock()
				if countdownConnection then countdownConnection:Disconnect() end
				countdownConnection = RunService.RenderStepped:Connect(function()
					if not rampageActive or not countdownBar then
						if countdownConnection then
							countdownConnection:Disconnect()
							countdownConnection = nil
						end
						return
					end
					local elapsed = os.clock() - rampStart
					local remaining = math.max(0, 1 - (elapsed / RAMPAGE_DURATION))
					countdownBar.Size = UDim2.new(remaining, 0, 1, 0)
					countdownBar.BackgroundColor3 = Color3.fromRGB(
						math.floor(255 * remaining + 80 * (1 - remaining)),
						math.floor(50 * remaining),
						math.floor(50 * remaining)
					)
					local glow = countdownBar:FindFirstChild("Glow")
					if glow then
						glow.Transparency = 0.3 + 0.4 * remaining
						glow.Thickness = 2 + 6 * (1 - remaining)
					end
				end)
			end
		end

		task.delay(RAMPAGE_DURATION, function()
			if rampageActive then
				endRampage()
			end
		end)
	end
end

local function processKills(player, state, gained)
	if gained <= 0 then return end
	local playerGui = player:FindFirstChild("PlayerGui")
	if not playerGui then return end

	for i = 1, gained do
		playSound(playerGui, KILL_SOUND_ID, false, 0.8)
		screenShake(0.3, 0.2)

		-- Kill flash
		screenFlash(Color3.fromRGB(255, 80, 80), 0.15)

		if rampageActive then
			state.pendingKills = (state.pendingKills or 0) + (gained - i + 1)
			return
		end

		state.soulsCount += 1
		if state.soulsCount >= MAX_SOULS then
			state.soulsCount = MAX_SOULS
			if state.killGoal then state.killGoal.Value = 0 end
			updateSoulsUI(state)
			startRampage(player)
			return
		else
			if state.killGoal then state.killGoal.Value = MAX_SOULS - state.soulsCount end
			updateSoulsUI(state)
		end
	end
end

local function hookCharacterAndInvulnerable(player, state, character, customDuration)
	local duration = customDuration or 30
	local status = player:FindFirstChild("Status")
	if not status then return end
	local healthValue = status:FindFirstChild("Health")
	if not healthValue then return end
	local timerTask

	local function stopInvulnerable()
		if timerTask then
			task.cancel(timerTask)
			timerTask = nil
		end
		local invFolder = status:FindFirstChild("Invulnerable")
		if invFolder then
			invFolder:Destroy()
		end
	end

	local function startInvulnerable()
		if timerTask then return end

		-- Create Invulnerable folder immediately
		local invFolder = status:FindFirstChild("Invulnerable")
		if not invFolder then
			invFolder = Instance.new("Folder")
			invFolder.Name = "Invulnerable"
			invFolder.Parent = status
		end
	end

	local function onHealthChanged()
		if healthValue.Value <= 0 then
			stopInvulnerable()
			state.soulsCount = 0
			state.pendingKills = 0
			if state.killGoal then state.killGoal.Value = MAX_SOULS end
			updateSoulsUI(state)

			-- Reset combo on death
			state.comboCount = 0
			state.totalDamage = 0
			state.comboDeadline = 0
			updateComboUI(state)

			task.spawn(showPopup, player, "YOU DISAPPOINT", DISAPPOINT_SOUND_ID)
		elseif healthValue.Value <= 100 then
			startInvulnerable()
		end
	end

	if state.healthConnection then
		state.healthConnection:Disconnect()
	end
	state.healthConnection = healthValue:GetPropertyChangedSignal("Value"):Connect(onHealthChanged)

	onHealthChanged()
end

-- UPDATED setupPlayer
local function setupPlayer(player)
	local playerGui = player:FindFirstChild("PlayerGui")
	if not playerGui then return end
	local status = player:FindFirstChild("Status")
	local statsFolder = status and status:FindFirstChild("Stats")
	local killsValue = statsFolder and statsFolder:FindFirstChild("Kills")
	local killGoalValue = statsFolder and ensureKillGoal(statsFolder) or nil

	local state = {
		soulsCount = 0,
		pendingKills = 0,
		killGoal = killGoalValue,
		soulsLabel = nil,
		healthConnection = nil,
		lastKills = killsValue and killsValue.Value or 0,
		damageProgress = 0,
		comboCount = 0,
		comboDeadline = 0,
		comboTask = nil,
		comboLabel = nil,
		comboBar = nil,
		comboBarBg = nil,
		comboBaseSize = nil,
		totalDamage = 0,
	}
	playerStates[player] = state

	-- GUI setup
