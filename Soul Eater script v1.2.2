	soulsLabel.TextScaled = true
	soulsLabel.Font = Enum.Font.Antique
	soulsLabel.TextXAlignment = Enum.TextXAlignment.Right
	soulsLabel.Parent = gui

	-- DAMAGE PROGRESS BAR
	local damageGui = Instance.new("ScreenGui")
	damageGui.Name = "DamageGui"
	damageGui.ResetOnSpawn = false
	damageGui.Parent = playerGui

	local damageBarBg = Instance.new("Frame")
	damageBarBg.Name = "Background"
	damageBarBg.Size = UDim2.new(0, 20, 0, 200)
	damageBarBg.Position = UDim2.new(1, -40, 0.5, -100)
	damageBarBg.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
	damageBarBg.BorderSizePixel = 0
	damageBarBg.Parent = damageGui

	local damageBar = Instance.new("Frame")
	damageBar.Name = "Bar"
	damageBar.Size = UDim2.new(1, 0, 0, 0)
	damageBar.Position = UDim2.new(0, 0, 1, 0)
	damageBar.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
	damageBar.BorderSizePixel = 0
	damageBar.Parent = damageBarBg

	local damageGradient = Instance.new("UIGradient")
	damageGradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(150, 0, 0)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 60, 60))
	})
	damageGradient.Rotation = 90
	damageGradient.Parent = damageBar

	state.damageGui = damageGui
	state.damageBar = damageBar
	state.damageValue = 0

	local progressBar = Instance.new("Frame")
	progressBar.Name = "ProgressBar"
	progressBar.Size = UDim2.new(0, 0, 0, 4)
	progressBar.Position = UDim2.new(0, 0, 1, 0)
	progressBar.BackgroundColor3 = Color3.new(1, 0, 0)
	progressBar.BorderSizePixel = 0
	progressBar.Parent = soulsLabel

	local progressGradient = Instance.new("UIGradient")
	progressGradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(120, 0, 0)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 50, 50))
	})
	progressGradient.Parent = progressBar

	state.soulsLabel = soulsLabel
	state.soulsBaseSize = soulsLabel.Size
	updateSoulsUI(state)

	-- COMBO COUNTER UI (bottom center, smaller)
	local comboGui = Instance.new("ScreenGui")
	comboGui.Name = "ComboGui"
	comboGui.ResetOnSpawn = false
	comboGui.Parent = playerGui

	local comboLabel = Instance.new("TextLabel")
	comboLabel.Name = "ComboText"
	comboLabel.Size = UDim2.new(0, 220, 0, 40)
	comboLabel.Position = UDim2.new(0.5, 0, 1, -50)
	comboLabel.AnchorPoint = Vector2.new(0.5, 0)
	comboLabel.BackgroundTransparency = 1
	comboLabel.Text = ""
	comboLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	comboLabel.TextScaled = true
	comboLabel.Font = Enum.Font.Antique
	comboLabel.TextTransparency = 1
	comboLabel.Parent = comboGui

	-- Timeout bar below combo text (hidden when no combo)
	local comboBarBg = Instance.new("Frame")
	comboBarBg.Name = "TimeoutBarBg"
	comboBarBg.Size = UDim2.new(0, 220, 0, 3)
	comboBarBg.Position = UDim2.new(0.5, 0, 1, -18)
	comboBarBg.AnchorPoint = Vector2.new(0.5, 0)
	comboBarBg.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
	comboBarBg.BorderSizePixel = 0
	comboBarBg.BackgroundTransparency = 1
	comboBarBg.Parent = comboGui

	local comboBar = Instance.new("Frame")
	comboBar.Name = "TimeoutBar"
	comboBar.Size = UDim2.new(0, 0, 1, 0)
	comboBar.BackgroundColor3 = Color3.fromRGB(255, 200, 50)
	comboBar.BorderSizePixel = 0
	comboBar.Parent = comboBarBg

	state.comboLabel = comboLabel
	state.comboBaseSize = comboLabel.Size
	state.comboBar = comboBar
	state.comboBarBg = comboBarBg

	task.spawn(showPopup, player, "CONSUME", CONSUME_SOUND_ID)

	local damageValueObject = status and status:FindFirstChild("DamageDone")

	-- Damage bar setup
	damageBar.AnchorPoint = Vector2.new(0, 1)
	damageBar.Position = UDim2.new(0, 0, 1, 0)

	local lastDamageDone = 0

	if damageValueObject then
		damageValueObject:GetPropertyChangedSignal("Value"):Connect(function()
			if not playerStates[player] then return end
			local state = playerStates[player]

			local delta = damageValueObject.Value - lastDamageDone
			lastDamageDone = damageValueObject.Value

			if delta > 0 then
				-- Register combo hit (tracks any damage increase)
				state.comboCount += 1
				state.totalDamage = (state.totalDamage or 0) + delta
				state.comboDeadline = os.clock() + COMBO_TIMEOUT
				updateComboUI(state)

				-- Start combo timeout watcher if not already running
				if not state.comboTask or coroutine.status(state.comboTask) == "dead" then
					state.comboTask = task.spawn(function()
						while true do
							task.wait(0.05)
							if not state.comboLabel or not state.comboLabel.Parent then break end
							if os.clock() >= state.comboDeadline then
								state.comboCount = 0
								state.totalDamage = 0
								state.comboDeadline = 0
								updateComboUI(state)
								break
							end
							if state.comboBar then
								local timeLeft = math.max(0, (state.comboDeadline - os.clock()) / COMBO_TIMEOUT)
								state.comboBar.Size = UDim2.new(timeLeft, 0, 1, 0)
							end
						end
					end)
				end

				if rampageActive then
					screenShake(math.clamp(delta / 50, 0.3, 1.5), 0.15)
				end

				local previous = state.damageProgress

				state.damageProgress = math.clamp(state.damageProgress + delta, 0, 40000)
				local percent = state.damageProgress / 40000

				if state.damageBar then
					state.damageBar.Size = UDim2.new(1, 0, percent, 0)
				end

				if previous < 40000 and state.damageProgress >= 40000 then
					-- flash bar
					TweenService:Create(state.damageBar, TweenInfo.new(0.15), {
						BackgroundColor3 = Color3.fromRGB(255, 255, 255)
					}):Play()

					task.delay(0.15, function()
						TweenService:Create(state.damageBar, TweenInfo.new(0.2), {
							BackgroundColor3 = Color3.fromRGB(200, 0, 0)
						}):Play()
					end)

					-- small screen feedback
					screenShake(1, 0.2)
					playSound(player.PlayerGui, BLOODLUST_ACTIVATE_SOUND_ID, false, 0.6)

					-- optional popup
					task.spawn(showPopup, player, "UNLEASH", BLOODLUST_READY_SOUND_ID)

					-- Pulsing damage bar while Bloodlust is ready
					if state.bloodlustPulseConn then state.bloodlustPulseConn:Disconnect() end
					local barRef = state.damageBar
					local barPulseStart = os.clock()
					state.bloodlustPulseConn = RunService.RenderStepped:Connect(function()
						if not barRef or not barRef.Parent or state.damageProgress < 40000 then
							if state.bloodlustPulseConn then
								state.bloodlustPulseConn:Disconnect()
								state.bloodlustPulseConn = nil
							end
							return
						end
						local pulse = 0.5 + 0.5 * math.sin((os.clock() - barPulseStart) * 6)
						barRef.BackgroundColor3 = Color3.fromRGB(200, 0, 0):Lerp(Color3.fromRGB(255, 255, 255), pulse)
					end)
				end
			end
		end)
	end

	-- Ensure state.killGoal has a fallback if statsFolder didn't exist
	if not state.killGoal then
		state.killGoal = { Value = MAX_SOULS }
	end

	-- BLOODLUST logic with smooth damage bar drain
	local function startBloodlust(player, state)
		if not status then return end
		local invListener

		-- Ensure Invulnerable folder exists
		local function ensureInvulnerable()
			if not status:FindFirstChild("Invulnerable") then
				local invFolder = Instance.new("Folder")
				invFolder.Name = "Invulnerable"
				invFolder.Parent = status
			end
		end

		ensureInvulnerable()

		-- Keep Invulnerable folder alive while BLOODLUST is active
		invListener = status.ChildRemoved:Connect(function(child)
			if child.Name == "Invulnerable" then
				ensureInvulnerable()
			end
		end)

		-- Stop pulsing damage bar
		if state.bloodlustPulseConn then
			state.bloodlustPulseConn:Disconnect()
			state.bloodlustPulseConn = nil
		end
		if state.damageBar then
			TweenService:Create(state.damageBar, TweenInfo.new(0.3), { BackgroundColor3 = Color3.fromRGB(200, 0, 0) }):Play()
		end

		-- Show BLOODLUST popup
		task.spawn(showPopup, player, "BLOODLUST", BLOODLUST_ACTIVATE_SOUND_ID)
		screenFlash(Color3.fromRGB(255, 200, 0), 0.3)

		-- Play Bloodlust loop sound (fade in)
		if bloodlustLoopSound then
			bloodlustLoopSound:Destroy()
			bloodlustLoopSound = nil
		end
		bloodlustLoopSound = playSound(SoundService, BLOODLUST_LOOP_SOUND_ID, true, 0)
		TweenService:Create(bloodlustLoopSound, TweenInfo.new(1), { Volume = 0.8 }):Play()

		-- Bloodlust golden color correction
		if bloodlustCC then bloodlustCC:Destroy() end
		bloodlustCC = Instance.new("ColorCorrectionEffect")
		bloodlustCC.Name = "BloodlustCC"
		bloodlustCC.Saturation = 0
		bloodlustCC.TintColor = Color3.new(1, 1, 1)
		bloodlustCC.Contrast = 0
		bloodlustCC.Parent = Lighting

		TweenService:Create(bloodlustCC, TweenInfo.new(1), {
			Saturation = 0.3,
			TintColor = Color3.fromRGB(255, 220, 100),
			Contrast = 0.12
		}):Play()

		-- After 40 seconds, end BLOODLUST
		task.delay(121, function()
			-- Disconnect invulnerability listener
			if invListener then
				invListener:Disconnect()
			end

			-- Fade out Bloodlust loop sound
			if bloodlustLoopSound then
				local oldSound = bloodlustLoopSound
				bloodlustLoopSound = nil
				TweenService:Create(oldSound, TweenInfo.new(2), { Volume = 0 }):Play()
				task.delay(2, function()
					if oldSound then oldSound:Destroy() end
				end)
			end

			-- Remove Invulnerable folder
			local invFolder = status:FindFirstChild("Invulnerable")
			if invFolder then invFolder:Destroy() end

			-- Fade out bloodlust golden color correction
			if bloodlustCC then
				TweenService:Create(bloodlustCC, TweenInfo.new(1), {
					Saturation = 0,
					TintColor = Color3.new(1, 1, 1),
					Contrast = 0
				}):Play()
				local ccRef = bloodlustCC
				bloodlustCC = nil
				task.delay(1, function()
					if ccRef then ccRef:Destroy() end
				end)
			end

			-- Smoothly drain the damage bar
			local startValue = state.damageProgress
			local bar = state.damageBar
			local playerState = state

			task.spawn(function()
				local duration = 1 -- drain duration in seconds
				local startTime = os.clock()

				while os.clock() - startTime < duration do
					if not playerStates[player] then break end
					local alpha = (os.clock() - startTime) / duration
					local value = startValue * (1 - alpha)

					playerState.damageProgress = value
					if bar then
						bar.Size = UDim2.new(1, 0, value / 40000, 0)
					end

					RunService.RenderStepped:Wait()
				end

				-- Ensure bar is fully reset
				if playerStates[player] then
					playerState.damageProgress = 0
					if bar then
						bar.Size = UDim2.new(1, 0, 0, 0)
					end
				end
			end)
		end)
	end

	-- BLOODLUST activation
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then return end

		if input.KeyCode == Enum.KeyCode.Z then
			local previousMode = rampageMode
			rampageMode = (rampageMode == "Fair") and "Infinite" or "Fair"

			-- If switching away from Infinite while rampage is active, end it instantly
			if previousMode == "Infinite" and rampageMode == "Fair" and rampageActive then
				endRampage()
			end

			task.spawn(showPopup, player, "MODE: "..rampageMode)
			return
		end

		if input.KeyCode == Enum.KeyCode.X and rampageMode == "Infinite" then
			if not rampageActive then
				infiniteRampage = true
				startRampage(player)
			else
				endRampage()
			end
			return
		end

		if input.KeyCode == Enum.KeyCode.C and state.damageProgress >= 40000 then
			local character = player.Character
			if character and (not status or not status:FindFirstChild("Invulnerable")) then
				startBloodlust(player, state)
			end
		end
	end)

	-- Monitor Kills
	if killsValue then
		killsValue:GetPropertyChangedSignal("Value"):Connect(function()
			if not playerStates[player] then return end
			local newKills = killsValue.Value
			local gained = newKills - state.lastKills
			if gained > 0 then
				processKills(player, state, gained)
			end
			state.lastKills = newKills
		end)
	end

	player.CharacterAdded:Connect(function(character)
		hookCharacterAndInvulnerable(player, state, character)
	end)

	if player.Character then
		hookCharacterAndInvulnerable(player, state, player.Character)
	end
end

Players.PlayerAdded:Connect(setupPlayer)
Players.PlayerRemoving:Connect(function(player)
	local removedState = playerStates[player]
	if removedState then
		if removedState.healthConnection then
			removedState.healthConnection:Disconnect()
		end
		if removedState.bloodlustPulseConn then
			removedState.bloodlustPulseConn:Disconnect()
			removedState.bloodlustPulseConn = nil
		end
	end
	if removedState.comboTask then
		task.cancel(removedState.comboTask)
		removedState.comboTask = nil
	end
	playerStates[player] = nil
	activePopups[player] = nil
end)

for _, player in ipairs(Players:GetPlayers()) do task.spawn(setupPlayer, player) end
