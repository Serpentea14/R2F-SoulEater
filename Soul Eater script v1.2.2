local activeShake = 0

local function screenShake(intensity, duration)
	activeShake += intensity

	task.spawn(function()
		local camera = workspace.CurrentCamera
		local start = os.clock()

		while os.clock() - start < duration do
			local t = (os.clock() - start) / duration
			local fade = 1 - t

			-- Rotation in degrees
			local pitch = math.sin(t * 40) * activeShake * 2.5 * fade
            local yaw   = math.cos(t * 36) * activeShake * 2.0 * fade
            local roll  = math.sin(t * 52) * activeShake * 1.0 * fade

			camera.CFrame *= CFrame.Angles(
				math.rad(pitch),
				math.rad(yaw),
				math.rad(roll)
			)

			RunService.RenderStepped:Wait()
		end

		activeShake -= intensity
	end)
end

local function screenFlash(color, duration)
	if not ENABLE_SCREEN_FLASH then return end
	local player = Players.LocalPlayer
	if not player then return end
	local playerGui = player:FindFirstChild("PlayerGui")
	if not playerGui then return end

	if screenFlashGui then
		screenFlashGui:Destroy()
	end

	screenFlashGui = Instance.new("ScreenGui")
	screenFlashGui.Name = "ScreenFlash"
	screenFlashGui.IgnoreGuiInset = true
	screenFlashGui.DisplayOrder = 2000
	screenFlashGui.Parent = playerGui

	local flash = Instance.new("Frame")
	flash.Size = UDim2.new(1, 0, 1, 0)
	flash.Position = UDim2.new(0, 0, 0, 0)
	flash.BackgroundColor3 = color
	flash.BorderSizePixel = 0
	flash.Parent = screenFlashGui

	local tween = TweenService:Create(flash, TweenInfo.new(duration or 0.5), { BackgroundTransparency = 1 })
	tween:Play()

	tween.Completed:Connect(function()
		screenFlashGui:Destroy()
		screenFlashGui = nil
	end)
end

local function FillHeat()
	if not eventsFolder or not movesFolder then return end

	local Event = eventsFolder:FindFirstChild("ME")
	local TauntMove = movesFolder:FindFirstChild("Taunt")

	if Event and TauntMove then
		for i = 1, 6 do
			local A_1 = {
				[1] = "heat",
				[2] = TauntMove
			}
			Event:FireServer(A_1)
		end
	end
end

local function playSound(parent, soundId, looped, volume)
	if not soundId then return end
	local sound = Instance.new("Sound")
	sound.SoundId = soundId
	sound.Looped = looped or false
	sound.Volume = volume or 1
	sound.Parent = parent
	sound:Play()

	if not looped then
		Debris:AddItem(sound, 10)
	end

	return sound
end

local function showTypewriterBillboard(character, message, soundId)
	local head = character:FindFirstChild("Head")
	if not head then return end

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "RampageBillboard"
	billboard.Size = UDim2.new(0, 400, 0, 100)
	billboard.StudsOffset = Vector3.new(0, 4, 0)
	billboard.Adornee = head
	billboard.AlwaysOnTop = true
	billboard.Parent = head

	local textLabel = Instance.new("TextLabel")
	textLabel.Size = UDim2.new(1, 0, 1, 0)
	textLabel.BackgroundTransparency = 1
	textLabel.Text = ""
	textLabel.TextColor3 = Color3.new(1, 0, 0)
	textLabel.TextStrokeTransparency = 0
	textLabel.TextStrokeColor3 = Color3.new(0, 0, 0)
	textLabel.TextScaled = true
	textLabel.Font = Enum.Font.Antique
	textLabel.Parent = billboard

	local currentSound = soundId or RAMPAGE_POPUP_SOUND_ID

	for i = 1, #message do
		local char = message:sub(i, i)
		textLabel.Text = message:sub(1, i)

		if char ~= " " then
			playSound(head, currentSound, false, 0.4)
			screenShake(0.5, 0.05)
		end
		task.wait(0.04)
	end

	task.wait(2)

	local fadeTween = TweenService:Create(textLabel, TweenInfo.new(1), { TextTransparency = 1, TextStrokeTransparency = 1 })
	fadeTween:Play()

	fadeTween.Completed:Connect(function()
		billboard:Destroy()
	end)
end

local activePopups = {}

local function showPopup(player, message, soundId)
	local playerGui = player:FindFirstChild("PlayerGui")
	if not playerGui then return end

	-- Remove any existing popup for this player so texts don't overlap
	local existing = activePopups[player]
	if existing then
		existing:Destroy()
		activePopups[player] = nil
	end

	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "RampagePopup"
	screenGui.IgnoreGuiInset = true
	screenGui.DisplayOrder = 999
	screenGui.Parent = playerGui
	activePopups[player] = screenGui

	-- Clean up reference when destroyed
	screenGui.AncestryChanged:Connect(function(_, parent)
		if not parent and activePopups[player] == screenGui then
			activePopups[player] = nil
		end
	end)

	local textLabel = Instance.new("TextLabel")
	textLabel.Size = UDim2.new(1, 0, 0, 120)
	textLabel.Position = UDim2.new(0, 0, 0.4, 0)
	textLabel.BackgroundTransparency = 1
	textLabel.Text = message:upper()
	textLabel.TextColor3 = Color3.new(1, 0, 0)
	textLabel.TextScaled = true
	textLabel.Font = Enum.Font.Antique
	textLabel.TextTransparency = 1
	textLabel.Parent = screenGui

	-- Glow stroke for popups
	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.new(1, 0, 0)
	stroke.Thickness = 3
	stroke.Transparency = 0.5
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	stroke.Parent = textLabel

	local gradient = Instance.new("UIGradient")
	gradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 80, 80)),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 0, 0)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(180, 0, 0))
	})
	gradient.Rotation = 90
	gradient.Parent = textLabel

	playSound(textLabel, soundId, false, 1)

	-- Drop shadow behind popup text
	local shadow = Instance.new("TextLabel")
	shadow.Name = "Shadow"
	shadow.Size = UDim2.new(1, 0, 0, 120)
	shadow.Position = UDim2.new(0, 3, 0.4, 3)
	shadow.BackgroundTransparency = 1
	shadow.Text = message:upper()
	shadow.TextColor3 = Color3.new(0, 0, 0)
	shadow.TextTransparency = 1
	shadow.TextStrokeTransparency = 1
	shadow.TextScaled = true
	shadow.Font = Enum.Font.Antique
	shadow.ZIndex = textLabel.ZIndex - 1
	shadow.Parent = screenGui

	local info = TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	local fadeIn = TweenService:Create(textLabel, info, { TextTransparency = 0, Position = UDim2.new(0, 0, 0.45, 0) })
	local shadowIn = TweenService:Create(shadow, info, { TextTransparency = 0.4, Position = UDim2.new(0, 3, 0.45, 3) })

	fadeIn:Play()
	shadowIn:Play()
	fadeIn.Completed:Wait()

	task.wait(2)

	-- If this popup was replaced by a newer one, stop here
	if not screenGui.Parent then return end

	local fadeOut = TweenService:Create(textLabel, TweenInfo.new(1), { TextTransparency = 1, Position = UDim2.new(0, 0, 0.5, 0) })
	local shadowOut = TweenService:Create(shadow, TweenInfo.new(1), { TextTransparency = 1, Position = UDim2.new(0, 3, 0.5, 3) })
	fadeOut:Play()
	shadowOut:Play()
	fadeOut.Completed:Wait()

	screenGui:Destroy()
end

local function showPopupToAll(message, soundId)
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(showPopup, player, message, soundId)
	end
end

local function updateSoulsUI(state)
	if state.soulsLabel then
		local percentage = state.soulsCount / MAX_SOULS
		state.soulsLabel.Text = "SOULS: " .. tostring(state.soulsCount) .. " / " .. MAX_SOULS

		local bar = state.soulsLabel:FindFirstChild("ProgressBar")
		if bar then
			TweenService:Create(bar, TweenInfo.new(0.3), { Size = UDim2.new(percentage, 0, 0, 4) }):Play()
		end

		if state.soulsCount > 0 then
			-- Color flash
			TweenService:Create(state.soulsLabel, TweenInfo.new(0.1), { TextColor3 = Color3.new(1, 0.2, 0.2) }):Play()
			task.delay(0.1, function()
				TweenService:Create(state.soulsLabel, TweenInfo.new(0.1), { TextColor3 = Color3.new(1, 0, 0) }):Play()
			end)

			-- Scale bounce
			local baseSize = state.soulsBaseSize or UDim2.new(0, 200, 0, 40)
			TweenService:Create(state.soulsLabel, TweenInfo.new(0.08, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
				Size = UDim2.new(baseSize.X.Scale, baseSize.X.Offset + 20, baseSize.Y.Scale, baseSize.Y.Offset + 8)
			}):Play()
			task.delay(0.08, function()
				TweenService:Create(state.soulsLabel, TweenInfo.new(0.12), { Size = baseSize }):Play()
			end)
		end
	end
end

local function updateComboUI(state)
	if not state.comboLabel then return end

	local text = ""
	if state.comboCount > 0 then
		text = "COMBO x" .. state.comboCount
		local dmgDisplay = string.format("%.1f", state.totalDamage or 0)
		text = text .. "  DMG: " .. dmgDisplay
	end
	state.comboLabel.Text = text

	if state.comboCount > 0 then
		state.comboLabel.TextTransparency = 0
		if state.comboBarBg then
			state.comboBarBg.BackgroundTransparency = 0
		end

		-- Color shifts from white to gold as combo increases
		local heat = math.clamp(state.comboCount / 25, 0, 1)
		local comboColor = Color3.fromRGB(255, 255, 255):Lerp(Color3.fromRGB(255, 200, 50), heat)
		state.comboLabel.TextColor3 = comboColor

		-- Scale bounce
		local baseSize = state.comboBaseSize or UDim2.new(0, 220, 0, 40)
		TweenService:Create(state.comboLabel, TweenInfo.new(0.08, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
			Size = UDim2.new(baseSize.X.Scale, baseSize.X.Offset + 10, baseSize.Y.Scale, baseSize.Y.Offset + 4)
		}):Play()
		task.delay(0.08, function()
			if state.comboLabel then
				TweenService:Create(state.comboLabel, TweenInfo.new(0.12), { Size = baseSize }):Play()
			end
		end)
	else
		state.comboLabel.TextTransparency = 1
		if state.comboBarBg then
			state.comboBarBg.BackgroundTransparency = 1
		end
		if state.comboBar then
			state.comboBar.Size = UDim2.new(0, 0, 1, 0)
		end
	end
end

local function ensureKillGoal(statsFolder)
	local killGoal = statsFolder:FindFirstChild("killgoal")
	if not killGoal then
		killGoal = Instance.new("IntValue")
		killGoal.Name = "killgoal"
		killGoal.Parent = statsFolder
	end
	killGoal.Value = MAX_SOULS
